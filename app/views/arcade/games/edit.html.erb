<% content_for :title, "Edit — #{@game.title}" %>

<div class="mb-6">
  <%= link_to "← back", arcade_game_path(@game), class: "font-mono text-xs text-gray-500 hover:text-purple-400" %>
  <h1 class="mt-2 font-mono text-2xl text-purple-400">◉ edit <%= @game.title %></h1>
  <p class="mt-1 font-mono text-xs text-gray-500">
    update metadata here. to re-ingest from source, use "resubmit source" below.
  </p>
</div>

<%= render "form",
      game: @game,
      form_url: arcade_game_path(@game),
      form_method: :patch,
      source_editable: false,
      cancel_path: arcade_game_path(@game),
      submit_label: "save" %>

<section class="mt-10 rounded-lg border border-gray-800 bg-gray-900 p-5 space-y-4">
  <h2 class="font-mono text-sm text-purple-400">◉ resubmit source</h2>
  <p class="font-mono text-xs text-gray-500">
    pulls the source again (git) or re-extracts the uploaded zip, then rebuilds.
  </p>

  <%= form_with url: resubmit_arcade_game_path(@game), method: :post,
        html: { multipart: true, class: "space-y-4", data: { controller: "game-source-toggle" } } do %>

    <div class="flex gap-4 font-mono text-sm">
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="radio" name="game[source][kind]" value="git"
               <%= "checked" if @game.source.to_h["kind"] == "git" %>
               data-game-source-toggle-target="radio"
               data-action="change->game-source-toggle#sync"
               class="accent-purple-500">
        <span class="text-gray-300">git URL</span>
      </label>
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="radio" name="game[source][kind]" value="zip"
               <%= "checked" if @game.source.to_h["kind"] == "zip" %>
               data-game-source-toggle-target="radio"
               data-action="change->game-source-toggle#sync"
               class="accent-purple-500">
        <span class="text-gray-300">.zip upload</span>
      </label>
    </div>

    <div data-game-source-toggle-target="gitPanel" class="space-y-3">
      <input type="text" name="game[source][git_url]"
             value="<%= @game.source.to_h['git_url'] %>"
             placeholder="https://github.com/you/your-mlx42-game"
             class="w-full rounded bg-black border border-gray-700 px-3 py-2 font-mono text-sm text-gray-200 focus:border-purple-500 focus:outline-none">
      <input type="text" name="game[source][git_ref]"
             value="<%= @game.source.to_h['git_ref'] %>"
             placeholder="branch or tag (optional)"
             class="w-full rounded bg-black border border-gray-700 px-3 py-2 font-mono text-sm text-gray-200 focus:border-purple-500 focus:outline-none">
    </div>

    <div data-game-source-toggle-target="zipPanel" class="space-y-3" hidden>
      <input type="file" name="game[source_archive]" accept=".zip,application/zip"
             class="block w-full text-xs font-mono text-gray-400 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:bg-purple-600 file:text-white file:font-mono hover:file:bg-purple-500">
    </div>

    <button type="submit"
            class="font-mono text-sm px-4 py-2 rounded bg-purple-600 text-white hover:bg-purple-500">
      resubmit & rebuild
    </button>
  <% end %>
</section>

<section class="mt-10 rounded-lg border border-red-900/50 bg-red-950/20 p-5">
  <h2 class="font-mono text-sm text-red-400">◉ danger zone</h2>
  <p class="mt-2 font-mono text-xs text-gray-500">
    this soft-deletes the game. scores and save data are retained but the game is removed from the arcade.
  </p>
  <%= button_to "delete game",
        arcade_game_path(@game),
        method: :delete,
        form: { data: { turbo_confirm: "Delete #{@game.title}?" } },
        class: "mt-3 font-mono text-xs px-3 py-2 rounded border border-red-700 text-red-400 hover:bg-red-900/40" %>
</section>
