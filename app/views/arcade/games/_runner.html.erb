<%#
  Arcade runner — a purpose-built partial for the public arcade that
  mounts both `mlx42-runner` (canvas + wasm loader) AND `arcade-bridge`
  (session/score/state bridge) on the same wrapper element. We deliberately
  don't reuse the author partial because that one references author-only
  routes (export endpoint, document path) that don't exist for games.
%>
<% js_url   = block.compiled? ? rails_blob_url(block.js_file)   : "" %>
<% wasm_url = block.compiled? ? rails_blob_url(block.wasm_file) : "" %>
<% data_url = (block.data_file.attached? && block.compiled?) ? rails_blob_url(block.data_file) : "" %>

<div id="arcade_runner_<%= block.id %>"
     data-controller="mlx42-runner arcade-bridge"
     data-mlx42-runner-block-id-value="<%= block.id %>"
     data-mlx42-runner-js-url-value="<%= js_url %>"
     data-mlx42-runner-wasm-url-value="<%= wasm_url %>"
     data-mlx42-runner-data-url-value="<%= data_url %>"
     data-mlx42-runner-export-url-value=""
     data-arcade-bridge-game-slug-value="<%= game.slug %>"
     data-arcade-bridge-csrf-token-value="<%= form_authenticity_token %>"
     class="relative rounded-lg overflow-hidden border border-gray-800 bg-black">

  <div class="relative bg-black" data-mlx42-runner-target="canvasContainer">
    <canvas id="mlx42_canvas_<%= block.id %>"
            data-mlx42-runner-target="canvas"
            tabindex="-1"
            width="800"
            height="600"
            class="w-full h-auto"></canvas>

    <div data-mlx42-runner-target="playOverlay"
         data-action="click->mlx42-runner#play"
         class="absolute inset-0 bg-black/80 flex items-center justify-center cursor-pointer hover:bg-black/70 transition-all group">
      <div class="text-center">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-purple-600 group-hover:bg-purple-500 group-hover:scale-110 transition-all shadow-2xl">
          <svg class="w-10 h-10 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </div>
        <p class="mt-4 text-white text-lg font-mono">click to play</p>
        <p class="mt-1 text-gray-400 text-xs font-mono"><%= game.title %></p>
      </div>
    </div>

    <div data-mlx42-runner-target="captureIndicator"
         style="display: none;"
         class="absolute top-2 left-2 bg-green-600 text-white text-xs px-3 py-1.5 rounded-lg shadow-lg z-20 font-mono">
      controls active — click canvas to release
    </div>

    <div data-mlx42-runner-target="loader"
         style="display: none;"
         class="absolute inset-0 bg-black/90 flex items-center justify-center z-30">
      <div class="text-center">
        <div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-purple-500 border-t-transparent"></div>
        <p class="mt-4 text-white text-sm font-mono">loading wasm…</p>
        <p data-mlx42-runner-target="loadProgress" class="text-xs text-gray-500 mt-1 font-mono"></p>
      </div>
    </div>
  </div>

  <div data-mlx42-runner-target="consoleSection" class="border-t border-gray-800 bg-gray-900 p-3 hidden">
    <textarea id="mlx42_console_<%= block.id %>"
              data-mlx42-runner-target="console"
              rows="6"
              readonly
              class="w-full font-mono text-xs bg-black text-green-400 p-3 rounded border border-gray-800 focus:outline-none"></textarea>
  </div>
</div>
