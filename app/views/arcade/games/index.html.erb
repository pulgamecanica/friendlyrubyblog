<% content_for :title, "Arcade — Games" %>

<div class="mb-8 flex items-start justify-between gap-4">
  <div>
    <h1 class="font-mono text-2xl text-purple-400">◉ arcade</h1>
    <p class="font-mono text-sm text-gray-500 mt-1">mlx42 games submitted by 42 students — play in your browser</p>
  </div>
  <%= link_to new_arcade_game_path,
        class: "font-mono text-xs px-3 py-2 rounded bg-purple-600 text-white hover:bg-purple-500 transition-colors whitespace-nowrap" do %>
    + submit a game
  <% end %>
</div>

<% if @games.any? %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @games.each do |game| %>
      <%= link_to arcade_game_path(game),
            class: "group block rounded-lg border border-gray-800 bg-gray-900 hover:border-purple-600 transition-colors overflow-hidden" do %>
        <div class="aspect-video bg-gray-950 flex items-center justify-center">
          <% if game.cover.attached? %>
            <%= image_tag game.cover, class: "h-full w-full object-cover" %>
          <% else %>
            <span class="font-mono text-4xl text-gray-800">◉</span>
          <% end %>
        </div>
        <div class="p-4">
          <h2 class="font-mono text-sm text-purple-400 group-hover:text-purple-300">
            <%= game.title %>
          </h2>
          <p class="font-mono text-xs text-gray-500 mt-1 line-clamp-2">
            <%= game.description.presence || "— no description —" %>
          </p>
          <div class="mt-3 text-xs font-mono text-gray-600">
            by <%= game.submitter&.name || "anon" %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="rounded-lg border border-dashed border-gray-800 p-12 text-center font-mono text-gray-600">
    no games yet.
  </div>
<% end %>
