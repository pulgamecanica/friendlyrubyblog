<!DOCTYPE html>
<html class="scroll-pt-14">
  <head>
    <title><%= content_for(:title) || "Arcade" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body id="arcade" class="min-h-screen bg-gray-950 text-gray-200 antialiased">
    <header class="sticky top-0 z-50 border-b border-gray-800 bg-gray-950/95 backdrop-blur-sm">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-14 items-center justify-between">
          <%= link_to arcade_root_path, class: "flex items-center gap-3 font-mono text-purple-400 hover:text-purple-300" do %>
            <span class="text-lg">◉</span>
            <span class="text-base">arcade</span>
          <% end %>

          <nav class="flex items-center gap-6 text-sm font-mono">
            <%= link_to "games", arcade_games_path, class: "text-gray-400 hover:text-purple-400 transition-colors" %>
            <%= link_to "my games", arcade_dashboard_path, class: "text-gray-400 hover:text-purple-400 transition-colors" %>
            <%= link_to "← blog", root_path, class: "text-gray-500 hover:text-gray-300 transition-colors" %>

            <% if current_player&.intra_login.present? %>
              <span class="text-xs text-purple-400">@<%= current_player.intra_login %></span>
              <%= button_to "sign out", arcade_sign_out_path, method: :delete,
                    class: "text-xs text-gray-500 hover:text-gray-300",
                    form: { class: "inline" } %>
            <% elsif intra_configured? %>
              <%= link_to arcade_auth_intra_path,
                    class: "text-xs px-3 py-1.5 rounded border border-purple-600 text-purple-400 hover:bg-purple-600 hover:text-white transition-colors" do %>
                sign in with 42
              <% end %>
            <% end %>
          </nav>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <% if notice.present? %>
        <div class="mt-4 rounded-lg bg-green-900/30 border border-green-700 text-green-300 px-4 py-3 text-sm font-mono"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="mt-4 rounded-lg bg-red-900/30 border border-red-700 text-red-300 px-4 py-3 text-sm font-mono"><%= alert %></div>
      <% end %>
    </div>

    <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
      <%= yield %>
    </main>

    <footer class="mt-20 border-t border-gray-800">
      <div class="mx-auto max-w-6xl px-4 py-6 text-center text-xs font-mono text-gray-600">
        arcade · mlx42 games by 42 students
      </div>
    </footer>
  </body>
</html>
