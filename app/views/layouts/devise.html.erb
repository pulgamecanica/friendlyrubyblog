<!DOCTYPE html>
<html class="dark">
  <head>
    <title><%= content_for(:title) || "Friendlyrubyblog · The Gate" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      .font-cinzel  { font-family: "Cinzel", serif; }
      .font-garamond { font-family: "EB Garamond", Georgia, serif; }

      /* Deep night sky over Middle-earth */
      .me-sky {
        background:
          radial-gradient(1200px 600px at 50% -10%, rgba(193,138,52,0.10), transparent 60%),
          radial-gradient(900px 500px at 80% 110%, rgba(120,53,15,0.18), transparent 55%),
          linear-gradient(180deg, #05070d 0%, #080a12 35%, #0a0c14 70%, #050609 100%);
      }

      /* Drifting starfield */
      .me-stars::before,
      .me-stars::after {
        content: "";
        position: absolute;
        inset: -50% -50% 40% -50%;
        background-image:
          radial-gradient(1px 1px at 20% 30%, rgba(255,255,255,0.8), transparent),
          radial-gradient(1px 1px at 75% 15%, rgba(255,255,255,0.7), transparent),
          radial-gradient(1.5px 1.5px at 45% 55%, rgba(255,246,214,0.9), transparent),
          radial-gradient(1px 1px at 90% 45%, rgba(255,255,255,0.6), transparent),
          radial-gradient(1px 1px at 12% 70%, rgba(255,255,255,0.5), transparent),
          radial-gradient(1.5px 1.5px at 60% 80%, rgba(255,255,255,0.55), transparent),
          radial-gradient(1px 1px at 35% 12%, rgba(255,255,255,0.6), transparent);
        background-repeat: no-repeat;
        animation: me-twinkle 6s ease-in-out infinite alternate;
        pointer-events: none;
      }
      .me-stars::after { animation-delay: 3s; opacity: 0.5; transform: scale(1.3); }

      @keyframes me-twinkle {
        from { opacity: 0.35; }
        to   { opacity: 0.85; }
      }

      /* The Ring + its slow turn */
      @keyframes me-ring-turn { to { transform: rotate(360deg); } }
      .me-ring-spin { animation: me-ring-turn 60s linear infinite; transform-origin: 50% 50%; }

      /* Inscription kindling to life */
      @keyframes me-kindle {
        0%, 100% { opacity: 0.55; filter: drop-shadow(0 0 2px rgba(245,158,11,0.5)); }
        50%      { opacity: 1;    filter: drop-shadow(0 0 9px rgba(245,158,11,0.95)); }
      }
      .me-inscription { animation: me-kindle 4.5s ease-in-out infinite; }

      /* Rising embers from the fires of the mountain */
      @keyframes me-rise {
        0%   { transform: translateY(0) scale(1);   opacity: 0; }
        15%  { opacity: 0.9; }
        100% { transform: translateY(-90vh) scale(0.4); opacity: 0; }
      }
      .me-ember {
        position: absolute;
        bottom: -10px;
        width: 3px; height: 3px;
        border-radius: 9999px;
        background: radial-gradient(circle, #fde68a 0%, #f59e0b 45%, rgba(120,53,15,0) 75%);
        animation: me-rise linear infinite;
        pointer-events: none;
      }

      @media (prefers-reduced-motion: reduce) {
        .me-ring-spin, .me-inscription, .me-stars::before, .me-stars::after, .me-ember {
          animation: none !important;
        }
      }
    </style>
  </head>

  <body class="me-sky min-h-screen text-amber-50/90 antialiased overflow-hidden">
    <!-- Flash messages for toasts -->
    <div data-controller="toast" data-toast-flash-value="<%= JSON.dump(flash.to_a) %>"></div>

    <!-- Starfield -->
    <div class="me-stars absolute inset-0 overflow-hidden"></div>

    <!-- Rising embers -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <% 14.times do |i| %>
        <span class="me-ember"
              style="left: <%= (i * 7 + 3) % 100 %>%;
                     animation-duration: <%= 7 + (i % 5) * 2 %>s;
                     animation-delay: <%= (i * 0.9).round(1) %>s;
                     opacity: <%= 0.4 + (i % 4) * 0.15 %>;"></span>
      <% end %>
    </div>

    <!-- Misty Mountains silhouette -->
    <svg class="absolute bottom-0 left-0 w-full h-[45vh] min-h-[280px]" viewBox="0 0 1440 400"
         preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <linearGradient id="me-far" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#13182a"/>
          <stop offset="100%" stop-color="#0a0d18"/>
        </linearGradient>
        <linearGradient id="me-near" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#0b0e18"/>
          <stop offset="100%" stop-color="#040509"/>
        </linearGradient>
      </defs>
      <!-- Far range -->
      <path fill="url(#me-far)" opacity="0.85"
            d="M0 400 L0 220 L120 150 L210 210 L330 90 L430 200 L560 120 L690 215 L820 110 L960 205 L1080 140 L1200 220 L1320 130 L1440 210 L1440 400 Z"/>
      <!-- Near range -->
      <path fill="url(#me-near)"
            d="M0 400 L0 300 L160 230 L300 320 L440 240 L600 330 L760 250 L900 335 L1060 255 L1220 330 L1360 270 L1440 320 L1440 400 Z"/>
    </svg>

    <!-- The Eye, watching faintly from afar -->
    <div class="absolute top-[14%] left-1/2 -translate-x-1/2 w-40 h-40 rounded-full blur-3xl opacity-[0.18] pointer-events-none"
         style="background: radial-gradient(circle, #f59e0b 0%, #b45309 40%, transparent 70%);"></div>

    <main class="relative z-10 min-h-screen flex flex-col items-center justify-center px-4 py-12">
      <!-- The One Ring -->
      <div class="relative mb-2 select-none" aria-hidden="true">
        <svg viewBox="0 0 220 220" class="w-44 h-44 sm:w-52 sm:h-52">
          <defs>
            <radialGradient id="me-gold" cx="50%" cy="42%" r="60%">
              <stop offset="0%"  stop-color="#fde68a"/>
              <stop offset="45%" stop-color="#f59e0b"/>
              <stop offset="100%" stop-color="#92400e"/>
            </radialGradient>
            <filter id="me-glow" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="3.5" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <path id="me-ring-path"
                  d="M110,110 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0"/>
          </defs>

          <!-- ambient halo -->
          <circle cx="110" cy="110" r="92" fill="none" stroke="#f59e0b" stroke-opacity="0.10" stroke-width="22"/>

          <!-- the band -->
          <circle cx="110" cy="110" r="72" fill="none" stroke="url(#me-gold)" stroke-width="13"/>
          <circle cx="110" cy="110" r="78.5" fill="none" stroke="#fff7e6" stroke-opacity="0.25" stroke-width="1"/>
          <circle cx="110" cy="110" r="65.5" fill="none" stroke="#78350f" stroke-opacity="0.6" stroke-width="1"/>

          <!-- the fiery inscription, ever turning -->
          <g class="me-ring-spin">
            <text class="me-inscription font-cinzel" fill="#fbbf24" filter="url(#me-glow)"
                  font-size="11.5" letter-spacing="2.4" font-weight="600">
              <textPath href="#me-ring-path" startOffset="0%">
                · ash nazg durbatulûk · ash nazg gimbatul · ash nazg thrakatulûk ·
              </textPath>
            </text>
          </g>
        </svg>
      </div>

      <!-- Title block -->
      <div class="text-center mb-8 px-2">
        <p class="font-cinzel tracking-[0.45em] text-[0.65rem] sm:text-xs text-amber-500/70 uppercase mb-3">
          Friendlyrubyblog
        </p>
        <h1 class="font-cinzel text-2xl sm:text-3xl font-semibold text-amber-100 drop-shadow-[0_2px_12px_rgba(245,158,11,0.25)]">
          <%= content_for?(:heading) ? yield(:heading) : "Speak, friend, and enter" %>
        </h1>
        <% if content_for?(:tagline) %>
          <p class="font-garamond italic text-amber-200/60 mt-2 text-base sm:text-lg">
            <%= yield :tagline %>
          </p>
        <% end %>
      </div>

      <!-- The Gate (form card) -->
      <div class="w-full max-w-md">
        <div class="relative rounded-2xl border border-amber-500/25 bg-gradient-to-b from-[#11131d]/95 to-[#0a0b12]/95 backdrop-blur-sm shadow-[0_0_60px_-15px_rgba(245,158,11,0.35)] px-7 py-8 sm:px-9 sm:py-10">
          <!-- corner runes -->
          <span class="absolute -top-px left-6 right-6 h-px bg-gradient-to-r from-transparent via-amber-500/50 to-transparent"></span>
          <span class="absolute -bottom-px left-6 right-6 h-px bg-gradient-to-r from-transparent via-amber-500/30 to-transparent"></span>

          <%= yield %>
        </div>

        <div class="mt-8">
          <%= render "devise/shared/links" %>
        </div>
      </div>

      <p class="font-garamond italic text-amber-200/30 text-sm mt-10 text-center max-w-sm">
        &ldquo;Not all those who wander are lost.&rdquo;
      </p>
    </main>
  </body>
</html>
