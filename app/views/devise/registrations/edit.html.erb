<% content_for :title, "Friendlyrubyblog · Tend your token" %>
<% content_for :heading, "Tend your token" %>
<% content_for :tagline, "Even a ring-bearer must care for what they carry." %>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="space-y-5">
    <div>
      <%= f.label :email, "Your name in the common tongue",
            class: "block font-cinzel text-[0.7rem] uppercase tracking-[0.2em] text-amber-400/80 mb-1.5" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full rounded-lg border border-amber-500/20 bg-black/30 px-4 py-2.5 font-garamond text-amber-50 placeholder-amber-200/25 focus:border-amber-400/60 focus:ring-2 focus:ring-amber-500/20 focus:outline-none transition" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="font-garamond text-sm italic text-amber-200/50">
        A raven awaits confirmation for: <span class="text-amber-200/80"><%= resource.unconfirmed_email %></span>
      </p>
    <% end %>

    <div>
      <%= f.label :password, "New secret word",
            class: "block font-cinzel text-[0.7rem] uppercase tracking-[0.2em] text-amber-400/80 mb-1.5" %>
      <p class="mb-1.5 font-garamond text-sm italic text-amber-200/40">Leave blank to keep the old word.</p>
      <%= f.password_field :password, autocomplete: "new-password",
            placeholder: "••••••••",
            class: "w-full rounded-lg border border-amber-500/20 bg-black/30 px-4 py-2.5 font-garamond text-amber-50 placeholder-amber-200/25 focus:border-amber-400/60 focus:ring-2 focus:ring-amber-500/20 focus:outline-none transition" %>
      <% if @minimum_password_length %>
        <p class="mt-1.5 font-garamond text-sm text-amber-200/40 italic">
          At least <%= @minimum_password_length %> runes long.
        </p>
      <% end %>
    </div>

    <div>
      <%= f.label :password_confirmation, "Speak it once more",
            class: "block font-cinzel text-[0.7rem] uppercase tracking-[0.2em] text-amber-400/80 mb-1.5" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
            placeholder: "••••••••",
            class: "w-full rounded-lg border border-amber-500/20 bg-black/30 px-4 py-2.5 font-garamond text-amber-50 placeholder-amber-200/25 focus:border-amber-400/60 focus:ring-2 focus:ring-amber-500/20 focus:outline-none transition" %>
    </div>

    <div>
      <%= f.label :current_password, "Your current secret word",
            class: "block font-cinzel text-[0.7rem] uppercase tracking-[0.2em] text-amber-400/80 mb-1.5" %>
      <p class="mb-1.5 font-garamond text-sm italic text-amber-200/40">We need it to be sure it is truly you.</p>
      <%= f.password_field :current_password, autocomplete: "current-password",
            placeholder: "••••••••",
            class: "w-full rounded-lg border border-amber-500/20 bg-black/30 px-4 py-2.5 font-garamond text-amber-50 placeholder-amber-200/25 focus:border-amber-400/60 focus:ring-2 focus:ring-amber-500/20 focus:outline-none transition" %>
    </div>

    <%= f.submit "Seal the changes",
          class: "w-full rounded-lg bg-gradient-to-b from-amber-500 to-amber-700 px-4 py-3 font-cinzel font-semibold uppercase tracking-[0.15em] text-amber-50 shadow-lg shadow-amber-900/40 hover:from-amber-400 hover:to-amber-600 active:scale-[0.99] transition cursor-pointer" %>
  </div>
<% end %>

<div class="mt-8 pt-6 border-t border-amber-500/15">
  <h3 class="font-cinzel text-sm text-red-300/90 mb-2">Cast it into the fire</h3>
  <p class="font-garamond text-sm text-amber-200/50 mb-3">
    Unhappy? You may unmake your account and let it return to the shadow.
  </p>
  <%= button_to "Destroy my account", registration_path(resource_name),
        data: { confirm: "This cannot be undone. Are you sure?", turbo_confirm: "This cannot be undone. Are you sure?" },
        method: :delete,
        class: "rounded-lg border border-red-500/40 bg-red-950/30 px-4 py-2 font-cinzel text-xs uppercase tracking-widest text-red-300 hover:bg-red-900/40 transition cursor-pointer" %>
</div>

<div class="mt-6 text-center">
  <%= link_to "← Turn back", :back, class: "font-garamond text-amber-200/55 hover:text-amber-300 transition" %>
</div>
