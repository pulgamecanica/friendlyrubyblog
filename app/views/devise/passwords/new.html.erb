<% content_for :title, "Friendlyrubyblog · Lost your secret word?" %>
<% content_for :heading, "Lost your secret word?" %>
<% content_for :tagline, "Send a raven, and the way shall be lit anew." %>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="space-y-5">
    <div>
      <%= f.label :email, "Your name in the common tongue",
            class: "block font-cinzel text-[0.7rem] uppercase tracking-[0.2em] text-amber-400/80 mb-1.5" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            placeholder: "frodo@shire.me",
            class: "w-full rounded-lg border border-amber-500/20 bg-black/30 px-4 py-2.5 font-garamond text-amber-50 placeholder-amber-200/25 focus:border-amber-400/60 focus:ring-2 focus:ring-amber-500/20 focus:outline-none transition" %>
    </div>

    <%= f.submit "Send the raven",
          class: "w-full rounded-lg bg-gradient-to-b from-amber-500 to-amber-700 px-4 py-3 font-cinzel font-semibold uppercase tracking-[0.15em] text-amber-50 shadow-lg shadow-amber-900/40 hover:from-amber-400 hover:to-amber-600 active:scale-[0.99] transition cursor-pointer" %>
  </div>
<% end %>
