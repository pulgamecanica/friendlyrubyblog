<nav class="flex flex-col items-center gap-2.5 text-center">
  <% link_class = "font-garamond text-amber-200/55 hover:text-amber-300 underline-offset-4 hover:underline transition" %>

  <%- if controller_name != 'sessions' %>
    <%= link_to "Return to the Gate", new_session_path(resource_name), class: link_class %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "Join the Fellowship", new_registration_path(resource_name), class: link_class %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "Lost your secret word?", new_password_path(resource_name), class: link_class %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <%= link_to "No raven brought the confirmation?", new_confirmation_path(resource_name), class: link_class %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <%= link_to "The Gate was barred against you?", new_unlock_path(resource_name), class: link_class %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to "Pass through #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false },
            class: "mt-1 rounded-lg border border-amber-500/30 px-4 py-2 font-cinzel text-xs uppercase tracking-widest text-amber-200/80 hover:bg-amber-500/10 transition" %>
    <% end %>
  <% end %>
</nav>
