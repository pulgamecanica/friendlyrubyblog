<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-cache="false"
       class="mb-6 rounded-lg border border-red-500/40 bg-red-950/40 px-4 py-3">
    <h2 class="font-cinzel text-sm text-red-300 flex items-center gap-2">
      <span aria-hidden="true">⚔</span>
      <%= I18n.t("errors.messages.not_saved",
                 count: resource.errors.count,
                 resource: resource.class.model_name.human.downcase)
       %>
    </h2>
    <ul class="mt-2 list-disc list-inside space-y-1 font-garamond text-sm text-red-200/80">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
