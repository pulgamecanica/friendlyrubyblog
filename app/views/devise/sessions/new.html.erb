<% content_for :title, "Friendlyrubyblog · Speak, friend, and enter" %>
<% content_for :heading, "Speak, friend, and enter" %>
<% content_for :tagline, "The Gate of Moria opens to those it knows." %>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="space-y-5">
    <div>
      <%= f.label :email, "Your name in the common tongue",
            class: "block font-cinzel text-[0.7rem] uppercase tracking-[0.2em] text-amber-400/80 mb-1.5" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            placeholder: "frodo@shire.me",
            class: "w-full rounded-lg border border-amber-500/20 bg-black/30 px-4 py-2.5 font-garamond text-amber-50 placeholder-amber-200/25 focus:border-amber-400/60 focus:ring-2 focus:ring-amber-500/20 focus:outline-none transition" %>
    </div>

    <div>
      <%= f.label :password, "The secret word",
            class: "block font-cinzel text-[0.7rem] uppercase tracking-[0.2em] text-amber-400/80 mb-1.5" %>
      <%= f.password_field :password, autocomplete: "current-password",
            placeholder: "mellon",
            class: "w-full rounded-lg border border-amber-500/20 bg-black/30 px-4 py-2.5 font-garamond text-amber-50 placeholder-amber-200/25 focus:border-amber-400/60 focus:ring-2 focus:ring-amber-500/20 focus:outline-none transition" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <label class="flex items-center gap-2.5 cursor-pointer group">
        <%= f.check_box :remember_me,
              class: "h-4 w-4 rounded border-amber-500/40 bg-black/40 text-amber-500 focus:ring-amber-500/30 focus:ring-offset-0" %>
        <span class="font-garamond text-amber-200/70 group-hover:text-amber-100 transition">Let the Gate remember me</span>
      </label>
    <% end %>

    <%= f.submit "Enter",
          class: "w-full rounded-lg bg-gradient-to-b from-amber-500 to-amber-700 px-4 py-3 font-cinzel font-semibold uppercase tracking-[0.15em] text-amber-50 shadow-lg shadow-amber-900/40 hover:from-amber-400 hover:to-amber-600 active:scale-[0.99] transition cursor-pointer" %>
  </div>
<% end %>
